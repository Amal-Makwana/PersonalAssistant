# Reminder App environment template
# Copy this file to .env and fill values as needed.

# General
NODE_ENV=development
APP_NAME=reminder-app

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/reminder_app

# Auth
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h

# Observability
LOG_LEVEL=info
SENTRY_DSN=
